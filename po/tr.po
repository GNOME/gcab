#: src/gcab.c:83
msgid "Dumping data to:"
msgstr "Veriler şuraya boşaltılıyor:"

#: src/gcab.c:120
msgid "Print program version"
msgstr "Program sürümünü yazdır"

#: src/gcab.c:121
msgid "Be verbose"
msgstr "Ayrıntılı ol"

#: src/gcab.c:122
msgid "Create archive"
msgstr "Arşiv oluştur"

#: src/gcab.c:123
msgid "Extract all files"
msgstr "Tüm dosyaları çıkart"

#: src/gcab.c:125
msgid "Refuse to extract more than N bytes (0 for unlimited)"
msgstr "N bayttan yükseğini çıkartmayı reddet (sınırsız için 0)"

#: src/gcab.c:125
msgid "N"
msgstr "N"

#: src/gcab.c:126
msgid "Dump reserved and extra data"
msgstr "Ayrılmış ve ekstra veriyi dök"

#: src/gcab.c:127
msgid "List content"
msgstr "İçeriği listele"

#: src/gcab.c:128
msgid "List content with file details"
msgstr "İçeriği dosya ayrıntılarıyla birlikte listele"

#: src/gcab.c:129
msgid "Change to directory DIR"
msgstr "DİZİN klasörüne geç"

#: src/gcab.c:129
msgid "DIR"
msgstr "DİZİN"

#: src/gcab.c:130
msgid "Use zip compression"
msgstr "Zip sıkıştırma kullan"

#: src/gcab.c:131
msgid "Do not include path"
msgstr "Yolu içerme"

#: src/gcab.c:132
msgid "Reserve space in cabinet for signing (e.g. -s 6144 reserves 6K bytes)"
msgstr "İmzalamak için alan ayır (örneğin -s 6144, 6K bayt ayırır)"

#: src/gcab.c:133
msgid "FILE INPUT_FILES..."
msgstr "DOSYA GİRDİ_DOSYALARI..."

#: src/gcab.c:144
msgid "- create a Cabinet file"
msgstr "- Cabinet dosyası oluştur"

#: src/gcab.c:145
msgid "Report bugs to:"
msgstr "Hataları şuraya bildir:"

#: src/gcab.c:147
msgid ""
"gcab saves many files together into a cabinet archive, and can restore\n"
"individual files from the archive."
msgstr ""
"gcab, çok dosyayı bir kabin arşivine kaydeder ve bu arşivden\n"
"tekil dosyaları geri yükleyebilir."

#: src/gcab.c:154
msgid "Option parsing failed"
msgstr "Seçenek ayrıştırma başarısız oldu"

#: src/gcab.c:164
msgid "Please specify a single operation"
msgstr "Lütfen tek bir işlem belirtin"

#: src/gcab.c:169
msgid "Extraction size limit must not be negative"
msgstr "Çıkartma boyut sınırı negatif olmamalıdır"

#: src/gcab.c:174
msgid "Reserved space must be between 0 and 65535 bytes"
msgstr "Ayrılmış alan 0 ve 65535 bayt arasında olmalıdır"

#: src/gcab.c:179
msgid "Cabinet file must be specified"
msgstr "Kabin dosyası belirtilmelidir"

#: src/gcab.c:194
msgid "Error reading"
msgstr "Okuma hatası"

#: src/gcab.c:224
msgid "<unknown-date>"
msgstr "<bilinmeyen-tarih>"

#: src/gcab.c:239
msgid "Error during extraction"
msgstr "Çıkartma sırasında hata oluştu"

#: src/gcab.c:255
msgid "Error while reading signature"
msgstr "İmza okunurken hata oluştu"

#: src/gcab.c:267
msgid "No input files specified"
msgstr "Girdi dosyaları belirtilmedi"

#: src/gcab.c:286
msgid "Cannot add file"
msgstr "Dosya eklenemiyor"

#: src/gcab.c:292
msgid "No files to be archived"
msgstr "Arşivlenecek dosya yok"

#: src/gcab.c:300
msgid "Cannot create cab file"
msgstr "Cab dosyası oluşturulamıyor"

#: src/gcab.c:306
msgid "Cannot add folder to cab file"
msgstr "Cab dosyasına klasör eklenemiyor"

#: src/gcab.c:316
msgid "Cannot write cab file"
msgstr "Cab dosyası yazılamıyor"
