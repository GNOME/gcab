#: src/gcab.c:83
msgid "Dumping data to:"
msgstr "Odlaganje podatkov v:"

#: src/gcab.c:120
msgid "Print program version"
msgstr "Izpiši različico programa"

#: src/gcab.c:121
msgid "Be verbose"
msgstr "Podrobni izpis"

#: src/gcab.c:122
msgid "Create archive"
msgstr "Ustvari arhiv"

#: src/gcab.c:123
msgid "Extract all files"
msgstr "Razširi vse datoteke"

#: src/gcab.c:125
msgid "Refuse to extract more than N bytes (0 for unlimited)"
msgstr "Zavrni izpis več kot N bajtov (0 pomeni neomejeno)"

#: src/gcab.c:125
msgid "N"
msgstr "N"

#: src/gcab.c:126
msgid "Dump reserved and extra data"
msgstr "Odloži izpis zadržanih in posebnih podatkov"

#: src/gcab.c:127
msgid "List content"
msgstr "Izpiši vsebino"

#: src/gcab.c:128
msgid "List content with file details"
msgstr "Izpiši seznam s podrobnostmi o datotekah"

#: src/gcab.c:129
msgid "Change to directory DIR"
msgstr "Zamenjaj mapo v mapo DIR"

#: src/gcab.c:129
msgid "DIR"
msgstr "MAPA"

#: src/gcab.c:130
msgid "Use zip compression"
msgstr "Uporabi stiskanje zip"

#: src/gcab.c:131
msgid "Do not include path"
msgstr "Ne vključi poti"

#: src/gcab.c:132
msgid "Reserve space in cabinet for signing (e.g. -s 6144 reserves 6K bytes)"
msgstr ""
"Zadrži prostor v kabinetu za podpisovanje (na primer -s 6144 zadrži 6Kb)"

#: src/gcab.c:133
msgid "FILE INPUT_FILES..."
msgstr "DATOTEKA VHODNE_DATOTEKE ..."

#: src/gcab.c:144
msgid "- create a Cabinet file"
msgstr "- ustvari datoteko cab"

#: src/gcab.c:145
msgid "Report bugs to:"
msgstr "Pošljite poročilo o hroščih na:"

#: src/gcab.c:147
msgid ""
"gcab saves many files together into a cabinet archive, and can restore\n"
"individual files from the archive."
msgstr ""
"Program gcab shrani več datotek v arhivsko datoteko cab, lahko pa tudi "
"obnovi\n"
"iz arhiva vse ali le posamične datoteke."

#: src/gcab.c:154
msgid "Option parsing failed"
msgstr "Razčlenjevanje možnosti je spodletelo"

#: src/gcab.c:164
msgid "Please specify a single operation"
msgstr "Navedite eno samo operacijo"

#: src/gcab.c:169
msgid "Extraction size limit must not be negative"
msgstr "Omejitev velikosti izvlečka ne sme biti negativna"

#: src/gcab.c:174
msgid "Reserved space must be between 0 and 65535 bytes"
msgstr "Rezervirani prostor mora biti med 0 in 65535 bajtov"

#: src/gcab.c:179
msgid "Cabinet file must be specified"
msgstr "Navesti je treba datoteko cab"

#: src/gcab.c:194
msgid "Error reading"
msgstr "Napaka pri branju"

#: src/gcab.c:224
msgid "<unknown-date>"
msgstr "<neznan-datum>"

#: src/gcab.c:239
msgid "Error during extraction"
msgstr "Napaka med razširjanjem"

#: src/gcab.c:255
msgid "Error while reading signature"
msgstr "Napaka med branjem podpisa"

#: src/gcab.c:267
msgid "No input files specified"
msgstr "Vhodne datoteke niso določene"

#: src/gcab.c:286
msgid "Cannot add file"
msgstr "Ni mogoče dodati datoteke"

#: src/gcab.c:292
msgid "No files to be archived"
msgstr "Ni datotek za arhiviranje"

#: src/gcab.c:300
msgid "Cannot create cab file"
msgstr "Ni mogoče ustvariti datoteke cab"

#: src/gcab.c:306
msgid "Cannot add folder to cab file"
msgstr "Ni mogoče dodati mape v datoteko cab"

#: src/gcab.c:316
msgid "Cannot write cab file"
msgstr "Ni mogoče zapisati datoteke cab"
