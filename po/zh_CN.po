#: src/gcab.c:83
msgid "Dumping data to:"
msgstr "将数据转储到："

#: src/gcab.c:120
msgid "Print program version"
msgstr "打印程序版本"

#: src/gcab.c:121
msgid "Be verbose"
msgstr "详尽模式"

#: src/gcab.c:122
msgid "Create archive"
msgstr "创建归档文件"

#: src/gcab.c:123
msgid "Extract all files"
msgstr "提取所有文件"

#: src/gcab.c:125
msgid "Refuse to extract more than N bytes (0 for unlimited)"
msgstr "拒绝提取超过 N 字节的数据（0 为无限制）"

#: src/gcab.c:125
msgid "N"
msgstr "N"

#: src/gcab.c:126
msgid "Dump reserved and extra data"
msgstr "转储保留区额外数据"

#: src/gcab.c:127
msgid "List content"
msgstr "列出内容"

#: src/gcab.c:128
msgid "List content with file details"
msgstr "列出文件内容与其详细信息"

#: src/gcab.c:129
msgid "Change to directory DIR"
msgstr "切换到指定目录"

#: src/gcab.c:129
msgid "DIR"
msgstr "目录"

#: src/gcab.c:130
msgid "Use zip compression"
msgstr "使用 zip 压缩"

#: src/gcab.c:131
msgid "Do not include path"
msgstr "不包括路径"

#: src/gcab.c:132
msgid "Reserve space in cabinet for signing (e.g. -s 6144 reserves 6K bytes)"
msgstr "在 cabinet 中预留签名空间（例如 -s 6144 会预留 6K 字节）"

#: src/gcab.c:133
msgid "FILE INPUT_FILES..."
msgstr "文件 输入文件..."

#: src/gcab.c:144
msgid "- create a Cabinet file"
msgstr "- 创建 Cabinet 文件"

#: src/gcab.c:145
msgid "Report bugs to:"
msgstr "将错误报告到："

#: src/gcab.c:147
msgid ""
"gcab saves many files together into a cabinet archive, and can restore\n"
"individual files from the archive."
msgstr ""
"gcab 可以将多个文件保存到一个 cabinet 归档文件内，还可以从归档文件中恢复单独"
"的文件。"

#: src/gcab.c:154
msgid "Option parsing failed"
msgstr "解析选项失败"

#: src/gcab.c:164
msgid "Please specify a single operation"
msgstr "请只指定一项操作"

#: src/gcab.c:169
msgid "Extraction size limit must not be negative"
msgstr "提取大小限制不能为负值"

#: src/gcab.c:174
msgid "Reserved space must be between 0 and 65535 bytes"
msgstr "保留空间必须在 0 到 65535 字节之间"

#: src/gcab.c:179
msgid "Cabinet file must be specified"
msgstr "必须指定 cabinet 文件"

#: src/gcab.c:194
msgid "Error reading"
msgstr "读取时出错"

#: src/gcab.c:224
msgid "<unknown-date>"
msgstr "<未知日期>"

#: src/gcab.c:239
msgid "Error during extraction"
msgstr "提取时出错"

#: src/gcab.c:255
msgid "Error while reading signature"
msgstr "读取签名时出错"

